# ==============================================================================
# SONICFORGE AI - MASTER STUDIO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# IMPORTANT: Never commit `.env.local` or any file containing real API keys to git.
# All private provider keys stay strictly on the server and are NEVER exposed to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE SDK CONFIGURATION (REQUIRED FOR CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# Note: Next.js exposes variables prefixed with `NEXT_PUBLIC_` to the browser bundle.
# In Firebase, the Web API Key, Project ID, and App ID identify your Firebase app
# to Firebase servers and are safely restricted by Firestore & Storage Security Rules.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRET API KEYS (NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# These secrets are strictly consumed by Next.js Server API routes (/api/*).
# They are NEVER sent to the client browser or included in frontend JavaScript.
# ------------------------------------------------------------------------------
# ElevenLabs API Key: Used server-side for AI Music & Sound Effects Generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Neural Analog API Key: Used server-side for AI Audio Stem Separation
NEURALANALOG_API_KEY=your_neuralanalog_api_key_here
# Alternative alias for stem separation:
AUDIO_SEPARATION_API_KEY=your_neuralanalog_api_key_here

# ------------------------------------------------------------------------------
# DEMUCS NEURAL STEM ENGINE (DUAL-ENVIRONMENT CONFIGURATION)
# ------------------------------------------------------------------------------
# • Local Development:
#   Runs on your PC via local-stem-server/start.bat.
#   Default URL: http://127.0.0.1:8765
#   LOCAL_STEM_PORT=8765
#
# • Production Deployment (Vercel):
#   Deploy huggingface-stem-space to Hugging Face Spaces (Gradio SDK + ZeroGPU),
#   or deploy local-stem-server to Render / RunPod.
#   Set this to your public Space ID or HTTPS URL in Vercel Project Environment Variables:
NEXT_PUBLIC_STEM_API_URL="http://127.0.0.1:8765"
# Or Hugging Face Space repository identifier:
# NEXT_PUBLIC_STEM_SPACE_ID="your-username/sonicforge-demucs"
#
# Optional server-side URL override (serverless to backend):
# STEM_API_URL="https://your-demucs-service.onrender.com"
#
# Optional backend authentication key (kept strictly private on server):
# STEM_API_KEY="your_secret_stem_api_key_here"
# ------------------------------------------------------------------------------

# Rime TTS API Key: Used server-side for Sonic Assistant Voice Synthesis
RIME_TTS_API_KEY=your_rime_tts_api_key_here

# Google Gemini API Key: (Optional) Used for AI Lyrics Generation & Studio Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. BROWSER LOCAL TOOLS (ZERO API KEYS REQUIRED!)
# ------------------------------------------------------------------------------
# The following modules operate 100% locally within the browser using Web Audio API:
# • SonicTune (Guitar/Bass/Ukulele Instrument Tuner & Pitchy Autocorrelation)
# • Sonic Harmonium (Synthesized Reed Instrument with Sargam & Web MIDI)
# • Sargam & Rhythm Studio (Tanpura Drone, Metronome & Tabla Taal Cycles)
# • Vocal Pitch Coach (Microphone pitch detection & contour trail)
# • Sonic Loop Lab (Multi-track recording, timeline arranger & WAV export)
# • Chord & Scale Explorer (Harmonic theory calculations & MIDI file export)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 4. APPLICATION & SUPPORT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SonicForge AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SUPPORT_EMAIL="support@sonicforge.ai"
