# ==============================================================================
# SONICFORGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# IMPORTANT: Never commit `.env.local` or any file containing real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE SDK CONFIGURATION
# ------------------------------------------------------------------------------
# Note: Next.js exposes variables prefixed with `NEXT_PUBLIC_` to the browser bundle.
# In Firebase, the Web API Key, Project ID, and App ID identify your Firebase app
# to Firebase servers and are safely restricted by Firestore & Storage Security Rules.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRET API KEYS (NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# These secrets are strictly consumed by Next.js Server API routes (/api/*).
# They are NEVER sent to the client browser or included in frontend JavaScript.
# ------------------------------------------------------------------------------
# ElevenLabs API Key: Used server-side for AI Music & Sound Effects Generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Rime TTS API Key: Used server-side for Sonic Assistant Voice Synthesis
RIME_TTS_API_KEY=your_rime_tts_api_key_here

# ------------------------------------------------------------------------------
# 3. APPLICATION & SUPPORT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SonicForge AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SUPPORT_EMAIL="support@sonicforge.ai"

